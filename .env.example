# 环境变量样例(把真密钥放本地 .env,不要传 GitHub)

# 大模型 API Key
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# 绘图工具
GPT_IMAGE_API_KEY=your_image_api_key_here

# 小红书相关
XHS_ACCOUNT_ID=your_account_id_here
XHS_COOKIE=your_cookie_here

# 业务参数
DEFAULT_TIME_WINDOW_DAYS=14
DEFAULT_CONTENT_LANGUAGE=zh-CN
